{
  "name": "tizo",
  "productName": "Video Downloader Tizo",
  "version": "0.0.9",
  "description": "Universal video downloader for Windows",
  "author": "BKHornYT",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "test:fetcher": "node --experimental-strip-types scripts/test-fetcher.ts",
    "test:essentials": "node --experimental-strip-types scripts/test-essentials.ts",
    "test:args": "node --experimental-strip-types scripts/test-args.ts",
    "test": "npm run typecheck && npm run test:args && npm run test:formats && npm run test:embeds && npm run test:stats",
    "icon": "node scripts/build-icon.mjs",
    "test:formats": "node --experimental-strip-types scripts/test-formats.ts",
    "test:embeds": "node --experimental-strip-types scripts/test-embeds.ts",
    "test:stats": "node --experimental-strip-types --import ./scripts/electron-stub-register.mjs scripts/test-stats.ts"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
